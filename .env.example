OKF_LLM_BASE_URL=http://your-openai-compatible-gateway/
OKF_LLM_API_KEY=sk-...
OKF_LLM_MODEL=your-chat-model

OKF_TAVILY_API_KEY=tvly-...

# Optional. If unset, vector recall uses local hashed-token embeddings.
OKF_EMBEDDING_BASE_URL=http://your-openai-compatible-gateway/
OKF_EMBEDDING_API_KEY=sk-...
OKF_EMBEDDING_MODEL=your-embedding-model

# Local BGE-M3 server example from scripts/bge_m3_embedding_server.py:
# OKF_EMBEDDING_BASE_URL=http://127.0.0.1:8008/v1
# OKF_EMBEDDING_API_KEY=okf-local
# OKF_EMBEDDING_MODEL=BAAI/bge-m3
# Optional for asymmetric embedding endpoints:
# OKF_EMBEDDING_QUERY_INPUT_TYPE=query
# OKF_EMBEDDING_DOCUMENT_INPUT_TYPE=passage
# OKF_EMBEDDING_BATCH_SIZE=64
# OKF_EMBEDDING_TIMEOUT_MS=30000
# OKF_EMBEDDING_RETRIES=3

# OpenClaw host/native embedding is preferred when configured; BGE/OKF is fallback.
# OPENCLAW_EMBEDDING_BASE_URL=http://127.0.0.1:8008/v1
# OPENCLAW_EMBEDDING_API_KEY=okf-local
# OPENCLAW_EMBEDDING_MODEL=BAAI/bge-m3

# External-process deadlines. Formal ingest never downloads transcription models.
OKF_PROBE_TIMEOUT_MS=20000
OKF_OCR_TIMEOUT_MS=180000
OKF_PDF_TIMEOUT_MS=180000
OKF_TRANSCRIPTION_TIMEOUT_MS=600000
OKF_DOUYIN_TIMEOUT_MS=180000
# Browserless Douyin HTTP resolver timeout (no Chromium required).
# OKF_DOUYIN_HTTP_TIMEOUT_SECONDS=30
# Optional recovery path only: enable a local browser resolver and optionally select its executable.
# OKF_DOUYIN_BROWSER_FALLBACK=1
# OKF_DOUYIN_BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
# OKF_DOUYIN_BROWSER_TIMEOUT_MS=75000

# Prepare Faster-Whisper explicitly with: npm run media:prepare
# Or point ingest at an existing local model directory:
# OKF_FASTER_WHISPER_MODEL_PATH=D:\models\faster-whisper-small
# OKF_FUNASR_MODEL_PATH=D:\models\funasr\paraformer-zh
# OKF_FUNASR_VAD_MODEL_PATH=D:\models\funasr\fsmn-vad
# OKF_FUNASR_PUNC_MODEL_PATH=D:\models\funasr\ct-punc
